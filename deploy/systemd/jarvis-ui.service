[Unit]
Description=JARVIS kiosk UI static server (localhost:8080)
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
ExecStart=/usr/bin/python3 @REPO@/deploy/ui-server.py @REPO@/apps/ui/dist
Restart=always
RestartSec=2
MemoryMax=64M

[Install]
WantedBy=default.target
