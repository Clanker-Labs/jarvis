# ---------------------------------------------------------------------------------------------
# JARVIS environment. Copy to .env (`make env` does it and generates the secrets for you).
# Runtime settings (providers, voice, colours, routing...) are edited in the admin panel and
# stored in the DB — only bootstrap values live here. API keys may be set here OR in admin.
# ---------------------------------------------------------------------------------------------

JARVIS_ENV=prod
# Which compose services run on this host: brain, pi (ui + audio node), tailnet, qdrant.
COMPOSE_PROFILES=brain,pi,tailnet
JARVIS_DATA_DIR=data
LOG_LEVEL=INFO

# --- Network. Services bind to 127.0.0.1; the `tailnet` sidecar publishes them on this ---------
# machine's Tailscale address (tailnet only). The brain refuses anything but loopback/100.x.y.z.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9000
UI_PORT=8080
# Ports the sidecar publishes on the tailnet (drop 8000 8080 to expose only the admin panel).
TAILNET_PORTS="8080 8000 9000"
# This machine's tailnet IP + names (filled by `make env`); trusted as Host/Origin by UI + admin.
TAILSCALE_IP=
TAILNET_HOSTS=
# Where the audio node finds the brain (change to ws://<brain-tailscale-ip>:8000 when it moves).
BRAIN_URL=ws://127.0.0.1:8000
# Brain URL handed to the kiosk page. "auto" = same host the page was opened on, port 8000.
BRAIN_WS_URL=auto
# Extra kiosk origins (tailnet ones are added from TAILNET_HOSTS automatically).
UI_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Secrets (generated by `make env`). ------------------------------------------------------
JARVIS_NODE_TOKEN=
JARVIS_SECRET_KEY=
# Initial admin password (hashed into the DB on first start; change it from the admin panel).
ADMIN_BOOTSTRAP_PASSWORD=

# --- Local LLM on the tailnet (OpenAI-compatible). ------------------------------------------
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# --- Optional API keys (can also be set in admin → Secrets). --------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Audio node (Pi). -----------------------------------------------------------------------
# ALSA device names (`arecord -L` / `aplay -L`); "default" follows PipeWire/Pulse.
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5

# --- Container user mapping (filled by `make env`). -------------------------------------------
JARVIS_UID=
JARVIS_GID=
AUDIO_GID=
